# Dependencias
node_modules/
.pnpm-store/

# Variables de entorno (NUNCA subir secretos)
.env
.env.local
.env.*.local
# Cadenas prohibidas locales para `npm run ci:secrets` (p. ej. contraseñas filtradas)
.secrets-denylist

# Build / salida
dist/
# Swap atómico del panel en el deploy (ci-cd.yml): web/dist.nuevo / web/dist.viejo
web/dist.*/
build/
.next/
.turbo/

# Logs y temporales
*.log
npm-debug.log*
.DS_Store
coverage/

# Backups de la base (datos reales de clientes — nunca a git)
backups/

# Base local de desarrollo (PGlite con PGLITE_DIR)
.pglite/

# Playwright (E2E del panel, ángulo 6 de TESTING.md)
playwright-report/
test-results/
blob-report/
.playwright/

# Capturas de referencia de diseño/UX (pesadas, no hace falta versionarlas)
docs/ux-review/**/*.png

# Worktrees temporales de agentes en paralelo (Agent tool, isolation: "worktree")
.claude/worktrees/

# Resultados de cada corrida de evals (`npm run eval`). La línea base que se versiona es
# eval/baseline.json (fuera de esta carpeta).
eval/results/
