{
  "name": "selyon-crm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel de Selyon CRM (React + TS). Se construye con Vite y lo sirve el server Node en /panel.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0"
  }
}
