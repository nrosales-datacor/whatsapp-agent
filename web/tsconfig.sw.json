{
  "// ": "Typecheck del service worker. Lib WebWorker (no DOM) para tipar self/clients/push.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/sw.ts"]
}
