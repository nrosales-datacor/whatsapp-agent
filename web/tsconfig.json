{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client"]
  },
  // El service worker (src/sw.ts) usa la lib WebWorker, que choca con DOM. Va en su
  // propio tsconfig.sw.json para no contaminar el typecheck de la app (ver typecheck).
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/sw.ts"]
}
