{
  "name": "selyon-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Selyon CRM (nombre provisional): software de gestión para negocios con cita, con agente de WhatsApp IA como módulo.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-timeout=120000 test/unit/*.test.ts test/security/*.test.ts test/reliability/*.test.ts test/architecture/*.test.ts",
    "test:e2e": "npm run web:build && playwright test",
    "db:check": "tsx scripts/checkMigrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:dev": "tsx scripts/seedDev.ts",
    "eval": "tsx eval/runEval.ts",
    "ci:versions": "node scripts/ci/checkExactVersions.mjs",
    "ci:env": "node scripts/ci/checkEnvExample.mjs",
    "ci:secrets": "node scripts/ci/checkSecrets.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web install --include=dev && npm --prefix web run build"
  },
  "dependencies": {
    "@sentry/node": "10.54.0",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "openai": "6.42.0",
    "postgres": "3.4.9",
    "stripe": "22.2.0",
    "tsx": "4.22.4",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.2",
    "@playwright/test": "1.60.0",
    "@types/node": "20.19.43",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.30.6",
    "typescript": "5.9.3"
  }
}
