{
  "name": "whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de WhatsApp con IA (soporte + agenda). Proyecto individual ejecutable.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.0.0",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
