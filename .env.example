# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Servidor ─────────────────────────────────────────────
PORT=3000

# Separar procesos web/worker (Carril F, F6 — opcional, no rompe el piloto).
# "todo" (default si se deja vacío): un solo proceso hace webhook+panel+landing
# Y los 3 workers de cola Y los 3 schedulers — el comportamiento de siempre, el
# que usa el piloto. "web": solo webhook/panel/landing/salud, sin workers ni
# schedulers. "worker": solo workers/schedulers, con un HTTP mínimo que sirve
# únicamente /salud (sin webhook/panel/landing — eso lo atiende la réplica
# "web"). Pensado para correr como DOS apps de PM2 en vez de una sola cuando el
# tráfico lo justifique (ver DEPLOY.md, sección "Separar procesos web/worker").
# ROL=todo

# Panel web (bandeja humana). Secreto para firmar las sesiones (cadena larga al azar).
# OBLIGATORIO en producción: con DATABASE_URL o NODE_ENV=production el server NO
# arranca sin él. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SESSION_SECRET=cambiame-por-una-cadena-larga-al-azar
# Subí este número para invalidar TODAS las sesiones del panel (forzar re-login global).
# PANEL_SESSION_VERSION=1

# Cifrado en reposo del access_token de WhatsApp de cada negocio (Carril F, F2).
# Antes ese token —el que permite ENVIAR mensajes como ese negocio— se guardaba en
# texto plano en wa_tenants.access_token: un dump, un backup mal guardado o una
# credencial de Supabase filtrada entregaba la capacidad de suplantar a TODOS los
# clientes. Ahora se cifra con AES-256-GCM y solo se descifra al armar el caché en
# memoria (el resto del código sigue viendo el token en claro, sin cambios).
# OBLIGATORIO en producción: con DATABASE_URL o NODE_ENV=production el server NO
# arranca sin él (mismo fail-closed que PANEL_SESSION_SECRET). 64 caracteres hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Para migrar tokens ya guardados en claro: npm run cifrar:tokens (idempotente).
# Rotación de la clave: ver DEPLOY.md.
TOKENS_ENCRYPTION_KEY=
# Hash de la contraseña del panel de cada negocio. NUNCA va en el código.
# Generalo con: npx tsx scripts/hashPassword.ts "TU_CLAVE" y pegá el "salt:hash".
PANEL_PASSWORD_HASH_SELYON=salt:hash
# Contraseña EN CLARO solo para el script de capturas del panel (scripts/shotPanel.mjs).
# Solo desarrollo; dejala vacía en producción.
PANEL_DEMO_PASSWORD=
# Superadmin del onboarding (/panel/admin): da de alta negocios sin tocar código.
# NO está atado a ningún negocio y NO vive en la base. Usá un usuario DISTINTO de los
# de panel y una clave FUERTE. Hash con: npx tsx scripts/hashPassword.ts "TU_CLAVE".
# Si quedan vacíos, el área /panel/admin existe pero nadie puede entrar.
PANEL_SUPERADMIN_USUARIO=
PANEL_SUPERADMIN_HASH=salt:hash

# ─── Notificaciones push del panel (Web Push / PWA) ───────
# Permiten avisar al operador en el celular cuando un cliente necesita atención,
# aunque el panel esté cerrado. Generá el par UNA vez con:
#   npx web-push generate-vapid-keys
# La pública se expone al navegador; la privada es SECRETA. Si las dejás vacías,
# el panel funciona igual pero sin notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifica al emisor ante el servicio de push (un mailto: o una URL del servicio).
VAPID_SUBJECT=mailto:soporte@selyon.app

# ─── WhatsApp Cloud API (Meta) ────────────────────────────
WHATSAPP_VERIFY_TOKEN=un-token-secreto-que-vos-elegis
WHATSAPP_APP_SECRET=...
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=...
GRAPH_API_VERSION=v21.0

# Fail-closed del token global (Carril F, F5 — auditoría ALTO-05).
# El token de WhatsApp es POR NEGOCIO y vive en wa_tenants.access_token. Antes, un
# tenant sin token propio caía en silencio al WHATSAPP_ACCESS_TOKEN de arriba y sus
# mensajes salían desde el NÚMERO DE PRUEBA de Meta en vez del suyo — el cliente lo ve
# y parece un producto roto. Ahora la env global aplica ÚNICAMENTE al tenant nombrado
# acá (compatibilidad con el piloto, que todavía no tiene token propio); cualquier otro
# negocio sin su token falla con un error explícito, nunca se redirige.
# Mismo criterio que GOOGLE_CALENDAR_TENANT_ID (ver E4).
# ⚠️ Si lo dejás vacío y hay tenants sin access_token propio, esos negocios NO envían.
WHATSAPP_ACCESS_TOKEN_TENANT_ID=

# ─── Embedded Signup de Meta (OPCIONAL, C4.2) ─────────────
# Deja que un negocio conecte su WhatsApp Business desde el onboarding (/panel/admin)
# con un popup de Facebook, sin copiar phone_number_id ni token a mano. Requiere que la
# app de Meta esté aprobada como Tech Provider + App Review (ver GUIA-META.md §B). Si
# quedan vacías, el onboarding usa el formulario manual de siempre (no pasa nada).
#   META_APP_ID: el id (público) de la app de Meta — developers.facebook.com → tu app.
#   META_ES_CONFIG_ID: id de la "configuración de Embedded Signup" creada en esa app.
#   (el app secret lo reutiliza de WHATSAPP_APP_SECRET de arriba).
META_APP_ID=
META_ES_CONFIG_ID=
# PIN de verificación en dos pasos (6 dígitos) para registrar el número recién conectado
# en la Cloud API. Sin él, el número se conecta pero queda SIN registrar (se puede
# registrar después a mano desde WhatsApp Manager). Elegí uno y guardalo.
WHATSAPP_REGISTER_PIN=

# ─── Base de datos (OPCIONAL) ─────────────────────────────
# Si la dejás vacía, el agente usa almacenamiento en memoria (no persiste).
# Si la llenás, guarda en PostgreSQL automáticamente.
# DATABASE_URL=postgresql://user:pass@localhost:5432/db
#
# Tamaño del pool de conexiones (Carril F, F7). Antes cada módulo creaba SU PROPIO pool
# (server, tenantStore, uso, campañas, rescate = 5 pools × ~10 conexiones = ~50 desde un
# solo proceso); al separar web/worker (F6) eso se multiplica y choca con el límite del
# pooler de Supabase, con un `too many connections` intermitente muy caro de diagnosticar.
# Ahora hay UN pool por proceso, dimensionable acá. Subilo con criterio: el techo es el
# límite del pooler dividido por la cantidad de procesos que corras.
# DB_POOL_MAX=10

# ─── Supabase Storage — fotos fuera de Postgres (OPCIONAL, Carril F, F9) ──
# Hoy, sin esto configurado, la foto que manda un cliente por WhatsApp se guarda
# como data URL base64 COMPLETA en wa_mensajes.media_url (texto): una foto de
# 4 MB ≈ 5,4 MB por fila, y el chat del panel trae hasta 100 mensajes por
# conversación. Con esto configurado, el binario va a un bucket PRIVADO de
# Supabase Storage y en la columna solo queda una ruta corta (~200 bytes); el
# panel pide una URL firmada de corta vida recién al mostrar el chat.
#
# NO es fail-closed a propósito (a diferencia de TOKENS_ENCRYPTION_KEY): si falta,
# el sistema sigue funcionando EXACTAMENTE como hoy (guarda el data URL base64),
# con un aviso por consola una sola vez. No bloquea el piloto si no se configura
# antes del deploy — configurala cuando quieras y las fotos NUEVAS empiezan a
# ahorrar espacio; las viejas se migran con `npm run migrar:fotos`.
#
# De dónde salen (Supabase Dashboard → Project Settings → API):
#   SUPABASE_URL: el "Project URL" (https://xxxx.supabase.co).
#   SUPABASE_SERVICE_ROLE_KEY: la key "service_role" (NO la "anon" — esa no
#     tiene permiso de escritura sobre un bucket privado). Es tan sensible como
#     un password de la base: nunca la expongas al navegador.
# Storage → creá un bucket PRIVADO (nombre por default "wa-fotos", configurable
# con SUPABASE_STORAGE_BUCKET si preferís otro).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=wa-fotos

# ─── Google Calendar (OPCIONAL) ───────────────────────────
# Crea el evento de cada cita en el calendario del negocio.
# Setup: Google Cloud Console → habilitar "Google Calendar API" → crear una
# Service Account y descargar su llave JSON. Estas dos credenciales son NUESTRAS y
# son globales; cada negocio comparte SU calendario con este email (permiso
# "Hacer cambios en eventos").
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...pegar private_key del JSON...\n-----END PRIVATE KEY-----\n"

# ⚠️ EL CALENDARIO ES POR NEGOCIO, NO POR .ENV (auditoría BLOQ-05). Cada dueño pega
# el ID de su calendario en el panel → "Mi negocio" → "Google Calendar", y queda en
# wa_tenants.google_calendar_id. Antes esto era una env global compartida por todos
# los tenants: las citas de un negocio (con nombre y teléfono del cliente final) se
# escribían en el calendario de OTRO negocio.
#
# Las dos variables de abajo son solo compatibilidad con el piloto de un cliente:
# GOOGLE_CALENDAR_ID se usa ÚNICAMENTE para el tenant nombrado en
# GOOGLE_CALENDAR_TENANT_ID. Cualquier otro negocio sin su columna configurada queda
# con Calendar apagado (nunca redirigido a un calendario ajeno). Lo recomendado es
# migrar ese tenant al panel y borrar ambas.
# GOOGLE_CALENDAR_ID=tucalendario@gmail.com
# GOOGLE_CALENDAR_TENANT_ID=selyon

# ─── Recordatorios de cita por WhatsApp (OPCIONAL) ────────
# Se envían solos: día antes (desde las 17:00) y mismo día (2 h antes).
# RECORDATORIOS_INTERVALO_MIN=5
# RECORDATORIO_DIA_ANTES_HORA=17:00
# RECORDATORIO_HORAS_ANTES=2
# Cuántos negocios se procesan a la vez en cada tick (Carril F, F12). Antes se recorrían
# en SERIE: con 50 negocios un tick podía pasarse del intervalo y solaparse con el
# siguiente, apilando carga sobre la base (los envíos duplicados nunca fueron el riesgo:
# el claim atómico de reclamarRecordatorio ya los cubre). El tick ahora no se solapa
# consigo mismo y avisa por consola si tarda más que el intervalo.
# RECORDATORIOS_CONCURRENCIA=5
# ⚠️ Fuera de la ventana de 24 h de Meta se necesita una PLANTILLA aprobada en
# el WhatsApp Manager (3 variables: {{1}} nombre, {{2}} servicio, {{3}} cuándo).
# Sin plantilla, se intenta texto libre (sirve para pruebas con el número de prueba).
# ⚠️ E8/BLOQ-06: estas dos ya NO son la fuente de verdad. La plantilla de recordatorio
# se configura POR NEGOCIO en el panel → "Mi negocio" (wa_tenants.plantilla_recordatorio
# y plantilla_idioma), porque las plantillas se aprueban por WABA — es decir, por cliente:
# el nombre aprobado en el WABA de un negocio NO existe en el del otro, así que con una
# env global los recordatorios funcionaban para UN solo cliente como máximo.
#
# Estas dos quedan solo como compatibilidad con el piloto:
# WHATSAPP_TEMPLATE_RECORDATORIO se aplica ÚNICAMENTE al tenant nombrado en
# WHATSAPP_TEMPLATE_TENANT_ID (mismo criterio fail-closed que GOOGLE_CALENDAR_TENANT_ID
# y WHATSAPP_ACCESS_TOKEN_TENANT_ID). Cualquier otro negocio sin su propia plantilla cae
# a TEXTO LIBRE con botones — nunca hereda la plantilla de otro.
# Lo recomendado es cargarla desde el panel y borrar estas tres.
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_cita
WHATSAPP_TEMPLATE_TENANT_ID=
# Idioma con que se aprobó la plantilla. A diferencia del nombre, esto NO es fail-closed
# (no es un secreto ni cruza datos entre negocios): es un default en cascada
# tenant.plantillaIdioma → esta env → "es". Aplica a recordatorios, campañas y rescate.
WHATSAPP_TEMPLATE_IDIOMA=es

# ─── Seguimiento post-servicio (OPCIONAL, C3.1) ────────────
# Horas después de la hora de la cita para preguntar si todo salió bien (pide
# reseña de Google si el negocio configuró el link en "Mi negocio", o escala a un
# humano si el cliente marcó que tuvo un problema). Mismo caveat de la ventana de
# 24 h que los recordatorios de arriba.
# POST_SERVICIO_HORAS_DESPUES=3

# ─── Motor de reseñas de Google completo (OPCIONAL, Carril D 1.3, plan Pro) ─
# Con plan Pro, el seguimiento post-servicio pasa a 3 botones (Excelente/Bien/
# Mal) y se trackea en el dashboard. Además, job diario que consulta el rating
# del negocio en Google (solo para tenants con "Place ID" configurado en "Mi
# negocio"). Sin GOOGLE_PLACES_API_KEY, el job es no-op (no rompe nada).
# Conseguí la key en Google Cloud Console → habilitar "Places API" → Credenciales.
GOOGLE_PLACES_API_KEY=
# Cada cuántos minutos se chequea si algún tenant necesita su snapshot de hoy
# (1 llamada real a Places API por tenant configurado, por día).
# REPUTACION_INTERVALO_MIN=60

# ─── Observabilidad (OPCIONAL) ─────────────────────────────
# Sin SENTRY_DSN, el bot funciona igual pero sin reportes de error (no-op).
# Creá un proyecto Node en sentry.io y pegá su DSN acá.
SENTRY_DSN=
# Cada cuántos minutos se vuelca a `pm2 logs` un resumen de msg/min, latencia
# del turno del agente y profundidad de la cola (wa_jobs pendientes).
# METRICAS_INTERVALO_MIN=5

# ─── Alertas a la plataforma: "bot mudo" (OPCIONAL) ────────
# Ver src/observabilidad/alertas.ts y vigilancia.ts. Las alertas SIEMPRE salen por
# log estructurado (`pm2 logs`, evento "alerta_plataforma") y por Sentry si hay
# SENTRY_DSN. Además, si definís esta URL, se manda un POST JSON {text, content}:
# sirve tal cual para un Incoming Webhook de Slack o un webhook de Discord.
# ALERTAS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# /salud?detalle=1&token=<este valor> agrega el resumen de vigilancia (lista ids de
# negocios). Sin esta variable, la vigilancia no se expone por HTTP.
# SALUD_DETALLE_TOKEN=cadena-larga-al-azar
# No repetir la misma alerta (tipo + negocio) antes de N minutos (default 60).
# Token inválido y "sin entrantes" usan 6 h; cuota agotada, 24 h.
# ALERTAS_COOLDOWN_MIN=60
# Cada cuántos minutos corren los detectores (default 5; solo el líder, F6).
# ALERTAS_INTERVALO_MIN=5
# Cola atascada: minutos que puede esperar el job pendiente (listo) más viejo.
# ALERTA_COLA_ATASCADA_MIN=10
# DLQ: jobs en error dentro de la ventana (por negocio) a partir de los cuales alerta.
# ALERTA_DLQ_VENTANA_MIN=60
# ALERTA_DLQ_UMBRAL=1
# Negocio sin mensajes entrantes: horas HÁBILES (dentro de su horario de atención,
# en su zona horaria) sin recibir nada estando abierto. 0 = detector apagado.
# ALERTA_SIN_ENTRANTES_HORAS=4

# ─── Botón "Mejorar plan" del panel (aviso de cuota al 80%/100%) ───
# No hay pasarela de pago todavía: el botón abre un WhatsApp (solo dígitos, con
# código de país) o, si no hay, un correo. Sin ninguno, el aviso sale sin botón.
# PLATAFORMA_CONTACTO_WHATSAPP=50688887777
# PLATAFORMA_CONTACTO_EMAIL=ventas@ejemplo.com

# ─── Backups (scripts/backupDb.ts, OPCIONAL) ───────────────
# Supabase Free NO incluye backups automáticos: este script los arma con
# pg_dump vía cron. Usá la conexión DIRECTA de Supabase (puerto 5432, NO el
# pooler de transacciones 6543 de DATABASE_URL) — Dashboard → Project Settings
# → Database → Connection string → "Direct connection".
# BACKUP_DATABASE_URL=postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
# Días de retención de los .sql.gz en ./backups (default 14).
# BACKUP_RETENCION_DIAS=14
# Mínimo de backups a conservar siempre, aunque sean más viejos que la retención.
# BACKUP_MINIMO=3
# Comando para copiar el backup fuera del droplet ({archivo} = ruta del .sql.gz).
# Ver DEPLOY.md §19.1. Sin esto, el backup solo vive en el mismo servidor.
# BACKUP_COMANDO_COPIA=rclone copy {archivo} remoto:wa-backups

# ─── Timeouts de red y agenda (OPCIONAL, todos con default sano) ───
# Ver src/red/timeouts.ts. Ni fetch ni el SDK de OpenAI traen un timeout razonable por
# default (OpenAI: 600 s × 3 intentos = 30 min), y con el worker serial una llamada
# colgada de UN cliente congela la cola de TODOS. Se fijaron valores cortos; estas
# variables solo hacen falta si un proveedor se pone lento en producción.
# OPENAI_TIMEOUT_MS=20000
# OPENAI_AUDIO_TIMEOUT_MS=45000
# OPENAI_MAX_REINTENTOS=1
# GRAPH_TIMEOUT_MS=15000
# MEDIA_TIMEOUT_MS=30000
# GOOGLE_TIMEOUT_MS=15000
# STORAGE_TIMEOUT_MS=20000

# Margen mínimo (minutos) entre "ahora" y el primer horario que se OFRECE para hoy.
# Nadie agenda para dentro de 5 minutos: el cliente necesita tiempo para llegar.
# (Antes se ofrecían horas ya transcurridas y la cita se creaba igual — BLOQ-09.)
# AGENDA_MARGEN_MINIMO_MIN=30

# Horas sin actividad del equipo (ni traspaso nuevo ni mensaje desde el panel) tras
# las cuales una conversación en modo humano vuelve al bot cuando el cliente escribe.
# Evita que un cliente quede sin respuesta para siempre si nadie lo atendió. 0 = nunca.
# MODO_HUMANO_VENCE_HORAS=12

# ─── Techo de costo de OpenAI (OPCIONAL, todos con default sano) ───
# Revisión pre-venta 2026-10. Ver src/red/limiteCliente.ts y src/billing/planes.ts.
# Máximo de respuestas del bot por cliente final (clienteWa) en la última hora. Al
# pasarlo, el bot no llama al LLM, avisa UNA vez al cliente y notifica al operador
# (los mensajes igual quedan en el panel). 0 = sin límite.
# LIMITE_CLIENTE_MENSAJES_HORA=30
# Detección de bucle con otro bot: el MISMO texto entrante (normalizado) repetido
# BUCLE_REPETICIONES veces dentro de BUCLE_VENTANA_MIN minutos pausa el bot en esa
# conversación (modo humano) y avisa al operador. Mínimo efectivo 4. 0 = desactivado.
# BUCLE_REPETICIONES=5
# BUCLE_VENTANA_MIN=10
# Tope mensual de GASTO de LLM por tenant, en USD (estimado de wa_uso_mensual). Al
# 100% el bot deja de llamar al LLM y pasa las conversaciones a humano. 0 = sin tope.
# TOPE_GASTO_LLM_USD_MES_BASICO=15
# TOPE_GASTO_LLM_USD_MES_PRO=40
# Override por tenant (sin migración): pares tenantId=usd separados por coma. 0 = sin tope.
# TOPE_GASTO_LLM_USD_MES_POR_TENANT=lavacar-rosales=60,otro-negocio=0
# Detalle de las fotos enviadas a visión: low (default, costo fijo y chico) | high | auto.
# OPENAI_VISION_DETALLE=low
