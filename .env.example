# Variables de entorno de Selyon CRM. Están todas las que lee el código de src/ y scripts/
# (lo verifica `npm run ci:env`); las de los módulos que todavía no se portaron van
# comentadas al final. Secretos reales SOLO en .env (gitignored), nunca acá.
# Qué secreto vive dónde, cómo se genera y cómo se rota (y qué hacer si se filtra): DEPLOY.md §26.
# Cada entorno nace con secretos NUEVOS: nunca se copian del .env del sistema viejo.

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
# URL pública de la app (sin barra final): base de los links que salen por correo
# (invitaciones, recuperación de clave). Nunca se arma con el header Host del request.
# En producción es necesaria (sin ella esos correos fallan); en desarrollo, vacía =
# http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://app.selyon.app
# "production" en el servidor: exige DATABASE_URL y activa el fail-closed de secretos.
# NODE_ENV=production
# Rol del proceso: "all" (default: HTTP + workers + schedulers en un solo proceso), "web"
# (solo HTTP: landing, panel, API, /health) o "worker" (colas y schedulers, con un HTTP
# mínimo que solo sirve /health). Para correr web y worker como dos apps de PM2.
# ROLE=all
# En un `pm2 reload` el server deja de tomar trabajo y espera las tareas en curso hasta
# este tope antes de salir (ms). Debe ser menor que kill_timeout de PM2 (30 s).
# SHUTDOWN_GRACE_MS=25000

# ─── Base de datos ────────────────────────────────────────
# OBLIGATORIA en producción. En desarrollo, si la dejás vacía, el server levanta un
# Postgres local en el mismo proceso (PGlite, con las migraciones reales): mismo SQL que
# producción, sin instalar nada.
# DATABASE_URL=postgresql://user:pass@localhost:5432/db
#
# Solo desarrollo sin DATABASE_URL: carpeta donde PGlite guarda los datos entre reinicios.
# Vacía = en memoria (se pierde al reiniciar).
# PGLITE_DIR=.pglite
#
# Aislamiento entre negocios en la base (RLS): en producción DATABASE_URL apunta al rol
# `app_runtime` (sin BYPASSRLS, ver scripts/rls/01-app-role.sql) y las migraciones y los
# scripts de operación (migrate.ts, backupDb.ts…) usan esta URL con el rol `postgres`.
# Sin ella, los scripts usan DATABASE_URL (dev).
# DATABASE_URL_MIGRATIONS=postgresql://postgres:pass@host:5432/postgres
#
# Tamaño del pool de conexiones (UNO por proceso). El techo es el límite del pooler de
# Supabase dividido por la cantidad de procesos que corras.
# DB_POOL_MAX=10
#
# Vida (ms) del caché del contexto de cada negocio (negocio, sucursales, horarios,
# terminología). Es lo máximo que otro proceso puede ver una config vieja después de un
# cambio; el proceso que hizo el cambio lo ve al instante.
# BUSINESS_CACHE_TTL_MS=30000

# ─── Cola de trabajos (src/platform/queue, procesos ROLE=worker|all) ───
# Jobs en paralelo por proceso. Cada uno usa una conexión del pool solo mientras consulta,
# no mientras corre el handler; para más capacidad, subir esto o sumar réplicas worker.
# QUEUE_CONCURRENCY=4
# Espera entre consultas a la cola cuando no hay trabajo (ms).
# QUEUE_POLL_MS=1000
# Un job "running" sin latido de su worker por más de esto se da por huérfano (el worker
# murió) y vuelve a la cola (ms). El latido corre cada 1/4 de este valor.
# QUEUE_LOCK_TIMEOUT_MS=300000
# Días que se conservan los jobs terminados bien antes de purgarlos (0 = no purgar). Los
# que llegaron a dead (DLQ) no se purgan solos.
# QUEUE_RETENTION_DAYS=7

# ─── Agenda y recordatorios (src/modules/scheduling) ──────
# Margen mínimo (minutos) entre ahora y el primer horario que se le ofrece a un cliente
# (agente de WhatsApp, reserva web). El equipo del panel puede tomar el próximo libre.
# BOOKING_MIN_LEAD_MIN=30
# Cada cuánto el loop de recordatorios (con lease, una réplica) encola los vencidos (ms).
# REMINDERS_INTERVAL_MS=60000

# ─── WhatsApp: webhook, pipeline y bandeja (src/modules/whatsapp) ───
# El webhook (/webhook/whatsapp) exige WHATSAPP_VERIFY_TOKEN y WHATSAPP_APP_SECRET (ver la
# sección "Módulo WhatsApp IA" más abajo); sin el secreto rechaza todo POST (firma).
# Tope del cuerpo de un POST de Meta (bytes).
# WHATSAPP_WEBHOOK_MAX_BODY_BYTES=1048576
# Tope de una foto o nota de voz descargada de Graph (bytes) y timeout de esa descarga (ms).
# WHATSAPP_MEDIA_MAX_BYTES=16777216
# GRAPH_MEDIA_TIMEOUT_MS=30000
# Tope propio de un AUDIO (bytes; default 3 MB ≈ 2 min de mp3 a 192 kbps): más grande ni se
# baja ni se transcribe y el cliente recibe el aviso "tu audio es muy largo".
# WHATSAPP_AUDIO_MAX_BYTES=3145728
# Freno de ingesta por negocio (token bucket): ráfaga tolerada, mensajes/seg sostenidos y
# cuántos segundos se difiere la respuesta al pasarse (el mensaje nunca se pierde). 0 = sin freno.
# WHATSAPP_INGEST_BURST=20
# WHATSAPP_INGEST_PER_SEC=1
# WHATSAPP_INGEST_DEFER_SEC=5
# Frenos por cliente: respuestas automáticas por hora (0 = sin tope) y detección de bucles
# con otro bot (el mismo texto N veces en M minutos pausa el bot; 0 = desactivado, mínimo 4).
# WHATSAPP_CLIENT_TURNS_PER_HOUR=30
# WHATSAPP_LOOP_REPEATS=5
# WHATSAPP_LOOP_WINDOW_MIN=10
# Los topes mensuales del agente (conversaciones y gasto de LLM) son los del plan del
# negocio: ver "Planes y límites" (PLAN_*_AI_*) más abajo.
# Horas sin actividad del equipo tras las que una conversación en modo humano vuelve al
# bot cuando el cliente escribe (0 = nunca).
# WHATSAPP_HUMAN_MODE_EXPIRES_HOURS=12
# Historial que recibe el agente: últimos N mensajes, sin los de hace más de D días.
# WHATSAPP_AGENT_HISTORY_MESSAGES=30
# WHATSAPP_AGENT_HISTORY_DAYS=30
# Red de seguridad raw_webhooks: cada cuánto se reprocesan (ms), intentos antes de
# descartar y días que se guardan los ya procesados/descartados.
# WHATSAPP_RAW_REPROCESS_INTERVAL_MS=300000
# WHATSAPP_RAW_WEBHOOK_MAX_ATTEMPTS=12
# WHATSAPP_RAW_WEBHOOK_RETENTION_DAYS=7
# Crecimiento (I6, plan Pro). Cada cuánto el barrido (con lease) encola los seguimientos
# post-servicio y los toques del rescate de cotizaciones (ms), y cuántas horas después del
# primer toque va el segundo (plantilla `quoteRecovery` del número).
# WHATSAPP_FOLLOW_UP_INTERVAL_MS=600000
# QUOTE_RECOVERY_INTERVAL_MS=600000
# QUOTE_RECOVERY_SECOND_TOUCH_HOURS=24
# Campañas: envíos por lote del despacho y pausa entre envíos (ms) de una misma campaña.
# CAMPAIGN_BATCH_SIZE=25
# CAMPAIGN_SEND_INTERVAL_MS=1000
# Transcripción de notas de voz (Whisper, usa OPENAI_API_KEY): timeout (ms) y precio por
# minuto en USD para estimar el costo.
# OPENAI_AUDIO_TIMEOUT_MS=60000
# OPENAI_WHISPER_USD_PER_MINUTE=0.006
# Duración máxima de una nota de voz que se transcribe y va al agente (segundos, 10-1800;
# default 120 = 2 min). Las notas de voz de WhatsApp (ogg/opus) se miden ANTES de Whisper.
# AGENT_AUDIO_MAX_SEC=120

# ─── Planes y límites (src/modules/billing) ───────────────
# Topes mensuales del agente de WhatsApp por plan (los aplica el pipeline antes de cada
# turno: al llegar, avisa al cliente y pasa la conversación a una persona). El superadmin
# puede cambiarlos por negocio (lo contratado, en extra_modules.limits). Cambiarlos acá
# pide reiniciar.
# Conversaciones por mes ("conversación" ≈ ventana de 24 h, como cobra Meta):
# PLAN_BASIC_AI_CONVERSATIONS=500
# PLAN_PRO_AI_CONVERSATIONS=3000
# Gasto de LLM por mes en USD: red de seguridad contra un costo desbocado (un bucle con otro
# autorespondedor es UNA conversación y miles de llamadas). No se le muestra al negocio.
# PLAN_BASIC_AI_LLM_USD=15
# PLAN_PRO_AI_LLM_USD=40

# ─── Cobro en línea con Stripe (src/modules/billing, OPCIONAL) ───
# Sin clave secreta, secreto del webhook y al menos un precio, no hay pago en línea: el
# cobro sigue manual (PROCESO-COBRO-MANUAL.md) y /billing/checkout|portal responden 503.
# Los montos viven en Stripe: acá solo el Price ID (price_…) de cada opción que se vende.
# El webhook va a https://<tu-dominio>/webhook/stripe con los eventos
# checkout.session.completed y customer.subscription.* (created, updated, deleted, paused, resumed).
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_BASIC=price_…
# STRIPE_PRICE_PRO=price_…
# STRIPE_PRICE_PRO_NO_AGENT=price_…
# Tope del cuerpo del webhook de Stripe, en bytes.
# STRIPE_WEBHOOK_MAX_BODY_BYTES=262144

# ─── Alta self-service (src/signup.ts) ────────────────────
# Registro público de negocios en /panel/signup. APAGADO por defecto: abrirlo es una
# decisión de negocio (AUDIT-v2: gate de seguridad y legal antes del modelo self-service).
# SIGNUP_ENABLED=1
# Días de prueba gratis con que nace un negocio registrado (1–90).
# SIGNUP_TRIAL_DAYS=14

# ─── Barrido del cobro (src/modules/billing) ──────────────
# Cuando el cobro deja de estar al día por Stripe (pago fallido o suscripción cancelada) o
# porque la prueba venció sin suscribirse, corre esta gracia y después el negocio se pausa
# solo (la dueña puede entrar a pagar; al pagar, se reactiva). El cobro manual no se pausa solo.
# BILLING_GRACE_DAYS=7
# Cada cuánto corre el barrido (pruebas vencidas → pago pendiente, y pausa con la gracia cumplida), en ms.
# BILLING_SWEEP_INTERVAL_MS=3600000

# ─── Sesiones del panel y superadmin ──────────────────────
# Secreto para firmar las sesiones (cadena larga al azar). OBLIGATORIO en producción: con
# DATABASE_URL o NODE_ENV=production el módulo de sesiones no carga sin él. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En producción se rechaza este placeholder, cualquier valor de <32 caracteres y los
# patrones adivinables (src/platform/config/requiredSecrets.ts): el proceso no arranca.
PANEL_SESSION_SECRET=cambiame-por-una-cadena-larga-al-azar
# Subí este número para invalidar TODAS las sesiones del panel (forzar re-login global).
# PANEL_SESSION_VERSION=1
# Superadmin (la plataforma: crea negocios). Una sola cuenta, definida acá: NO vive en la
# base ni está atada a ningún negocio. Sin usuario y hash, nadie entra a /panel/admin.
PANEL_SUPERADMIN_USERNAME=admin
# Hash scrypt de la clave del superadmin (npx tsx scripts/hashPassword.ts "TU_CLAVE").
PANEL_SUPERADMIN_HASH=salt:hash
# Segundo factor (TOTP, RFC 6238) del superadmin. Si está definido, el login de
# /panel/admin EXIGE el código de 6 dígitos de una app autenticadora. OBLIGATORIO en
# producción con el superadmin configurado (usuario + hash): sin él, o si no es un base32
# de ≥128 bits, el proceso no arranca (src/platform/config/requiredSecrets.ts).
# Generalo con:  npx tsx scripts/generateTotp.ts
# PANEL_SUPERADMIN_TOTP_SECRET=
# Duración de la sesión del superadmin en horas (default 8, tope 12). La del equipo es de 7 días.
# PANEL_ADMIN_SESSION_HOURS=8
# Subí este número para echar SOLO al superadmin (p. ej. si sospechás que se filtró su
# cookie) sin desloguear a todos los negocios (eso es PANEL_SESSION_VERSION).
# PANEL_ADMIN_SESSION_VERSION=1

# ─── Cifrado en reposo de secretos de terceros ────────────
# AES-256-GCM para los tokens que hay que guardar en la base (p. ej. el de WhatsApp de cada
# negocio). OBLIGATORIA en producción (mismo fail-closed que PANEL_SESSION_SECRET).
# 64 caracteres hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKENS_ENCRYPTION_KEY=

# ─── Proxy y rate limit del login ─────────────────────────
# Proxies de confianza delante del Node (para saber la IP REAL del cliente en el rate
# limit del login). Sin esto se ignora X-Forwarded-For (lo puede falsificar cualquiera) y
# se usa la IP del socket — detrás de Caddy/nginx en el mismo servidor eso es 127.0.0.1
# para TODOS, y el límite por IP pasa a ser uno solo global. Valores:
#   loopback                → Caddy/nginx en el mismo servidor (el caso de DEPLOY.md)
#   1                       → número de proxies delante (cuenta saltos desde el socket)
#   127.0.0.1,10.0.0.0/8    → lista de IPs/CIDR de los proxies
TRUST_PROXY=loopback
# Ajustes del rate limit (opcionales; los defaults alcanzan):
# PANEL_LOGIN_RATE_LIMIT_MAX_IP=10              # intentos por IP por ventana
# PANEL_LOGIN_RATE_LIMIT_WINDOW_MS=300000       # ventana (5 min)
# PANEL_LOGIN_LOCKOUT_THRESHOLD=5               # fallos seguidos de una IP contra un usuario → lockout de ese par
# PANEL_LOGIN_LOCKOUT_BASE_MS=30000             # primer lockout del par (se duplica en cada fallo)
# PANEL_LOGIN_LOCKOUT_MAX_MS=900000             # tope del lockout (15 min)
# PANEL_LOGIN_LOCKOUT_GLOBAL_THRESHOLD=25       # fallos contra un usuario desde CUALQUIER IP → freno global
# PANEL_LOGIN_LOCKOUT_GLOBAL_BASE_MS=60000      # (no aplica a IPs desde las que esa cuenta ya entró bien)

# ─── Cabeceras de seguridad ───────────────────────────────
# HSTS se manda solo si la request llegó por https (TLS directo o X-Forwarded-Proto: https
# del proxy). "1" lo fuerza siempre, "0" lo apaga (p. ej. dominio sin https todavía).
# SECURITY_HSTS=

# ─── Supabase Storage: archivos fuera de Postgres (OPCIONAL) ──
# Los binarios (fotos, adjuntos, logos) van a un bucket PRIVADO; en la base queda solo la
# ruta y se sirven con URLs firmadas de corta vida. Sin esto, subir falla y firmar
# devuelve null (cada módulo decide qué hacer).
# De dónde salen (Supabase Dashboard → Project Settings → API):
#   SUPABASE_URL: el "Project URL" (https://xxxx.supabase.co).
#   SUPABASE_SERVICE_ROLE_KEY: la key "service_role" (NO la "anon"). Tan sensible como un
#     password de la base: nunca la expongas al navegador.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado (default "media").
# SUPABASE_STORAGE_BUCKET=media
# Timeout de cada llamada a Storage (ms).
# STORAGE_TIMEOUT_MS=20000

# ─── Correo de la plataforma (src/platform/email) ─────────
# Invitaciones al equipo, recuperación de clave y recordatorios por correo.
# Proveedor: "resend" (envía de verdad) o "log" (no envía: guarda en memoria y loguea sin
# datos personales). Vacío = "log" en desarrollo y tests. En producción (NODE_ENV=production)
# tiene que ser "resend": sin eso cada envío FALLA con un error claro y una alerta.
# EMAIL_PROVIDER=resend
# API key de Resend (Dashboard → API Keys, permiso "Sending access"). Secreto: solo en .env.
# RESEND_API_KEY=re_...
# Remitente. El dominio tiene que estar verificado en Resend (Dashboard → Domains).
# EMAIL_FROM="Selyon CRM <no-reply@selyon.app>"
# Timeout de cada envío a Resend (ms); si se pasa, la cola reintenta el job.
# EMAIL_TIMEOUT_MS=10000

# ─── Observabilidad (OPCIONAL) ─────────────────────────────
# Sin SENTRY_DSN el producto funciona igual pero sin reportes de error (no-op); en
# producción el arranque lo advierte (evento "sentry_missing_in_production"). Un solo
# proyecto de Sentry para el servidor y el panel: con este DSN se activan los dos (el panel
# lo recibe en su index, se distinguen por el tag `app`). Probalo con
# `npx tsx scripts/sentryTestEvent.ts` (DEPLOY.md §16).
SENTRY_DSN=
# Versión que corre (SHA del commit): la fija el deploy de GitHub Actions al recargar PM2.
# A mano solo si deployás sin el pipeline.
# SENTRY_RELEASE=
# Opcional: otra clave (Client Key) del MISMO proyecto solo para el panel. El DSN del panel
# es público (va en el HTML): con su propia clave se le pone un tope o se revoca sin tocar
# la del servidor. Vacío = el panel usa SENTRY_DSN.
# SENTRY_PANEL_DSN=
# Cada cuántos minutos se vuelca a `pm2 logs` el resumen de eventos y latencia por negocio.
# METRICS_INTERVAL_MIN=5
# SLO: alerta a la plataforma si el p95 de latencia de un negocio supera esto (ms).
# METRICS_SLO_LATENCY_P95_MS=15000
# Las alertas a la plataforma SIEMPRE salen por log estructurado (evento "platform_alert")
# y por Sentry si hay SENTRY_DSN. Con esta URL, además, un POST JSON {text, content}:
# sirve tal cual para un Incoming Webhook de Slack o un webhook de Discord.
# ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# No repetir la misma alerta (tipo + negocio) antes de N minutos (default 60).
# ALERTS_COOLDOWN_MIN=60
# /health?detail=1&token=<este valor> devuelve el JSON de chequeos (incluye errores
# internos). Sin esta variable, /health solo responde el texto plano.
# HEALTH_DETAIL_TOKEN=cadena-larga-al-azar
# Timeout del ping a Postgres de /health (ms); pasado esto /health responde 503.
# HEALTH_DB_TIMEOUT_MS=1500

# ─── Backups (scripts/backupDb.ts y scripts/verifyRestore.ts, OPCIONAL) ───
# Supabase Free NO incluye backups automáticos: backupDb.ts los arma con pg_dump vía cron.
# Usá la conexión DIRECTA de Supabase (puerto 5432, NO el pooler de transacciones 6543).
# BACKUP_DATABASE_URL=postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
# Base VACÍA y separada donde verifyRestore.ts restaura el volcado para comparar conteos.
# Nunca la de producción.
# RESTORE_DATABASE_URL=postgresql://postgres:pass@db.yyyy.supabase.co:5432/postgres
# Días de retención de los .sql.gz en ./backups (default 14).
# BACKUP_RETENTION_DAYS=14
# Mínimo de backups a conservar siempre, aunque sean más viejos que la retención.
# BACKUP_MIN_KEEP=3
# Comando para copiar el backup fuera del servidor ({file} = ruta del .sql.gz). Sin esto,
# el backup solo vive en el mismo servidor.
# BACKUP_COPY_COMMAND=rclone copy {file} remoto:backups

# ─── Módulo WhatsApp IA (src/modules/whatsapp) ───
# OpenAI (agente y transcripción de audios). Sin OPENAI_API_KEY el agente no corre y cada
# conversación pasa a una persona desde la bandeja.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=20000
# WhatsApp Cloud API (Meta). El token de cada negocio va cifrado en la base, no acá.
# Si están definidos, en producción ambos deben tener ≥32 caracteres al azar y no ser el
# placeholder de abajo (si no, el proceso no arranca; ver requiredSecrets.ts).
# WHATSAPP_VERIFY_TOKEN=un-token-secreto-que-vos-elegis
# WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v21.0
# GRAPH_TIMEOUT_MS=15000
# Embedded Signup (conectar el WhatsApp del negocio desde el alta):
# META_APP_ID=
# META_ES_CONFIG_ID=
# WHATSAPP_REGISTER_PIN=
# Google (Calendar por negocio y Places para reseñas; se reactivan en I6):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_PLACES_API_KEY=
# GOOGLE_TIMEOUT_MS=15000
# Notificaciones push de la bandeja (Web Push / PWA): npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@selyon.app

# ─── Agente IA de WhatsApp (src/modules/whatsapp/agent) ───
# Usa OPENAI_API_KEY, OPENAI_MODEL y OPENAI_TIMEOUT_MS de arriba (timeout por llamada).
# Reintentos ante un error transitorio de OpenAI dentro del turno (0-3):
# AGENT_OPENAI_RETRIES=1
# Tope de llamadas al modelo por turno (1-10); al agotarse, pasa a una persona:
# AGENT_MAX_STEPS=5
# Historial que ve el agente: últimos N mensajes (2-100) y ventana en días (0 = sin ventana):
# AGENT_HISTORY_MAX_MESSAGES=20
# AGENT_HISTORY_MAX_DAYS=30
# Citas futuras vivas que el agente le deja tener a un mismo cliente (1-50):
# AGENT_MAX_UPCOMING_APPOINTMENTS=3
# Tope de tokens de salida por llamada al modelo (100-4000; va como max_completion_tokens):
# AGENT_MAX_OUTPUT_TOKENS=600
# Margen extra de salida para modelos de razonamiento (gpt-5, o1/o3/o4), que piensan dentro
# del mismo tope (0-30000):
# AGENT_REASONING_EXTRA_TOKENS=3000
# Presupuesto del prompt de sistema en caracteres (8000-200000; ~3,5 caracteres por token).
# Guardar una configuración que lo pase da 422; si el catálogo crece después, el turno
# recorta descripciones de servicios → FAQ → base de conocimiento:
# AGENT_MAX_SYSTEM_PROMPT_CHARS=32000
# Re-tarifar el modelo de OPENAI_MODEL sin deploy (USD por 1M tokens; sin valor = tabla del código):
# OPENAI_PRICE_INPUT_USD_PER_1M=0.15
# OPENAI_PRICE_CACHED_INPUT_USD_PER_1M=0.075
# OPENAI_PRICE_OUTPUT_USD_PER_1M=0.60

# ─── Guardrail de CI (scripts/ci/checkEnvExample.mjs) ───
# Toda variable que lee el código de src/ o scripts/ debe aparecer en este archivo (como
# `NOMBRE=` o comentada `# NOMBRE=`). Si una variable NO debe documentarse acá (p. ej. la
# fija un script para sí mismo), declarala como excepción explícita con una línea
# `# env-check: ignore NOMBRE — motivo`.
# env-check: ignore CHECK_SECRETS_DENYLIST — solo CI (secret de GitHub que lee scripts/ci/checkSecrets.mjs), no es config de la app
# env-check: ignore GITHUB_ACTIONS — la define GitHub Actions; scripts/ci/checkAudit.mjs la usa para anotar avisos/errores, no es config de la app
